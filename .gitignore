# --- Data and models (large files, not tracked) ---
data/
dataset/
*.svs
*.pth

# Trained model weights inside the results folder (plots/metrics are kept)
results/*.pth

# Report / documents (not tracked)
pdf_output.txt
*.pdf

# Archives / backups (e.g. the ~1.5 GB Colab archive)
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
.venv/
*.egg-info/
.ipynb_checkpoints/

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Superpowers SDD scratch workspace (ledger, briefs, review packages)
.superpowers/

# Test scratch trees: prepare_output refuses a target outside the project root, so
# the tests that exercise it place their output inside the checkout
.pytest-tmp/
